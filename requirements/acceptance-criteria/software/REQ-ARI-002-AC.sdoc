[ACCEPTANCE_CRITERION]
UID: REQ-ARI-002.AC-1
STATEMENT: Subtraction of "3" from "5" (a = "5", b = "3") gives "2".
VERIF_LEVELS: unit, system
RELATIONS:
- TYPE: Parent
  VALUE: REQ-ARI-002

[ACCEPTANCE_CRITERION]
UID: REQ-ARI-002.AC-2
STATEMENT: Subtraction with a = "3" and b = "5" gives "-2".
VERIF_LEVELS: unit, system
RELATIONS:
- TYPE: Parent
  VALUE: REQ-ARI-002

[ACCEPTANCE_CRITERION]
UID: REQ-ARI-002.AC-3
